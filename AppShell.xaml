<?xml version="1.0" encoding="UTF-8" ?>
<Shell
  x:Class="floofy.AppShell"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:views="clr-namespace:floofy.Views"
  Title="floofy"
  Shell.NavBarIsVisible="False"
  Shell.TabBarBackgroundColor="White"
  Shell.TabBarForegroundColor="#B19CD9"
  Shell.TabBarUnselectedColor="#A89BBB">

  <TabBar>
    <ShellContent
      ContentTemplate="{DataTemplate views:Home}">
      <ShellContent.Icon>
        <FontImageSource 
          FontFamily="Arial"
          Glyph="🏠"
          Size="24"/>
      </ShellContent.Icon>
    </ShellContent>

    <ShellContent
      ContentTemplate="{DataTemplate views:Shop}">
      <ShellContent.Icon>
        <FontImageSource 
          FontFamily="Arial"
          Glyph="🛍️"
          Size="24"/>
      </ShellContent.Icon>
    </ShellContent>

    <ShellContent
      ContentTemplate="{DataTemplate views:Community}">
      <ShellContent.Icon>
        <FontImageSource 
          FontFamily="Arial"
          Glyph="👥"
          Size="24"/>
      </ShellContent.Icon>
    </ShellContent>

    <ShellContent
      ContentTemplate="{DataTemplate views:FloofyPlus}">
      <ShellContent.Icon>
        <FontImageSource 
          FontFamily="Arial"
          Glyph="🏥"
          Size="24"/>
      </ShellContent.Icon>
    </ShellContent>

    <ShellContent
      ContentTemplate="{DataTemplate views:Profile}">
      <ShellContent.Icon>
        <FontImageSource 
          FontFamily="Arial"
          Glyph="👤"
          Size="24"/>
      </ShellContent.Icon>
    </ShellContent>
  </TabBar>

</Shell>
