<?xml version="1.0" encoding="UTF-8" ?>
<Shell
  x:Class="floofy.AppShell"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:views="clr-namespace:floofy.Views"
  Title="floofy"
  Shell.NavBarIsVisible="False"
  Shell.TabBarIsVisible="False">

  <TabBar>
    <ShellContent
      Route="home"
      Title="Home"
      ContentTemplate="{DataTemplate views:Home}"/>

    <ShellContent
      Route="shop"
      Title="Shop"
      ContentTemplate="{DataTemplate views:Shop}"/>

    <ShellContent
      Route="community"
      Title="Community"
      ContentTemplate="{DataTemplate views:Community}"/>

    <ShellContent
      Route="plus"
      Title="Plus"
      ContentTemplate="{DataTemplate views:FloofyPlus}"/>

    <ShellContent
      Route="profile"
      Title="Profile"
      ContentTemplate="{DataTemplate views:Profile}"/>
  </TabBar>

</Shell>
