<?xml version="1.0" encoding="UTF-8" ?>
<Shell
  x:Class="floofy.AppShell"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:views="clr-namespace:floofy.Views"
  Title="floofy">

  <TabBar>
    <ShellContent
      Title="Home"
      ContentTemplate="{DataTemplate views:Home}"/>

    <ShellContent
      Title="Shop"
      ContentTemplate="{DataTemplate views:Shop}"/>

    <ShellContent
      Title="Community"
      ContentTemplate="{DataTemplate views:Community}"/>

    <ShellContent
      Title="Floofy+"
      ContentTemplate="{DataTemplate views:FloofyPlus}"/>

    <ShellContent
      Title="Profile"
      ContentTemplate="{DataTemplate views:Profile}"/>
  </TabBar>

</Shell>
