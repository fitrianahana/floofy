<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="floofy.Views.Shop"
             Title="Shop"
             NavigationPage.HasNavigationBar="False">

  <Grid RowDefinitions="Auto,Auto,Auto,*"
        BackgroundColor="#F8F7FC"
        Padding="0"
        RowSpacing="0">

    <!-- Header Section -->
    <VerticalStackLayout Grid.Row="0"
                         Padding="24,20,24,0"
                         Spacing="8">
      <Label Text="Shop"
             FontSize="28"
             FontAttributes="Bold"
             TextColor="#2D1B4E"/>
      <Label Text="Browse and discover amazing products"
             FontSize="13"
             TextColor="#6B5B8C"
             LineBreakMode="WordWrap"/>
    </VerticalStackLayout>

    <!-- Search Bar -->
    <VerticalStackLayout Grid.Row="1"
                         Padding="24,16,24,0"
                         Spacing="8">
      <SearchBar x:Name="SearchBar"
                 Placeholder="Search products or pets..."
                 Text="{Binding SearchQuery}"
                 SearchButtonPressed="OnSearchButtonPressed"
                 IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                 PlaceholderColor="#A89BBB"
                 TextColor="#2D1B4E"
                 BackgroundColor="White"
                 CancelButtonColor="#6B5B8C"/>
      <Label Text="{Binding ErrorMessage}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource StringBoolConverter}}"
             TextColor="#FF6B6B"
             FontAttributes="Bold"
             FontSize="12"/>
    </VerticalStackLayout>

    <!-- Section Toggle -->
    <Grid Grid.Row="2"
          Padding="24,16,24,12"
          ColumnDefinitions="*,*"
          ColumnSpacing="10">
      <Border Grid.Column="0"
              Stroke="#DDD2FF"
              StrokeThickness="1"
              StrokeShape="RoundRectangle 10,10,10,10"
              BackgroundColor="White"
              Padding="0">
        <Button Text="🐾 Pets"
                Command="{Binding SwitchToPetsCommand}"
                BackgroundColor="White"
                TextColor="#2D1B4E"
                BorderWidth="0"
                FontSize="13"
                FontAttributes="Bold">
          <Button.Triggers>
            <DataTrigger TargetType="Button"
                         Binding="{Binding IsPetsSectionActive}"
                         Value="True">
              <Setter Property="BackgroundColor" Value="#B19CD9"/>
              <Setter Property="TextColor" Value="White"/>
            </DataTrigger>
          </Button.Triggers>
        </Button>
      </Border>
      <Border Grid.Column="1"
              Stroke="#DDD2FF"
              StrokeThickness="1"
              StrokeShape="RoundRectangle 10,10,10,10"
              BackgroundColor="White"
              Padding="0">
        <Button Text="🛍️ Products"
                Command="{Binding SwitchToProductsCommand}"
                BackgroundColor="White"
                TextColor="#2D1B4E"
                BorderWidth="0"
                FontSize="13"
                FontAttributes="Bold">
          <Button.Triggers>
            <DataTrigger TargetType="Button"
                         Binding="{Binding IsProductsSectionActive}"
                         Value="True">
              <Setter Property="BackgroundColor" Value="#B19CD9"/>
              <Setter Property="TextColor" Value="White"/>
            </DataTrigger>
          </Button.Triggers>
        </Button>
      </Border>
    </Grid>

    <!-- Content -->
    <Grid Grid.Row="3">

      <ActivityIndicator IsRunning="{Binding IsLoading}"
                         IsVisible="{Binding IsLoading}"
                         Color="#B19CD9"
                         VerticalOptions="Center"
                         HorizontalOptions="Center"
                         Margin="0,20,0,0"/>

      <!-- Pets List -->
      <CollectionView ItemsSource="{Binding Pets}"
                      IsVisible="{Binding IsPetsSectionActive}"
                      Margin="24,12,24,12">
        <CollectionView.ItemsLayout>
          <LinearItemsLayout Orientation="Vertical"
                             ItemSpacing="12"/>
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <Border StrokeShape="RoundRectangle 12,12,12,12"
                    Stroke="#DDD2FF"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="0">
              <Grid ColumnDefinitions="100,*" ColumnSpacing="12" Padding="12">
                <!-- Pet Image -->
                <Image Grid.Column="0"
                       Source="dotnet_bot.png"
                       HeightRequest="100"
                       WidthRequest="100"
                       Aspect="AspectFill"/>
                
                <!-- Pet Details -->
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                  <Label Text="{Binding Name}"
                         FontSize="15"
                         FontAttributes="Bold"
                         TextColor="#2D1B4E"/>
                  <Label Text="{Binding Species}"
                         FontSize="11"
                         TextColor="#6B5B8C"/>
                  <Label Text="{Binding Breed}"
                         FontSize="11"
                         TextColor="#6B5B8C"/>
                  <Label Text="{Binding Age, StringFormat='Age: {0} year(s)'}"
                         FontSize="11"
                         TextColor="#6B5B8C"/>
                  <Label Text="{Binding Description}"
                         FontSize="11"
                         TextColor="#6B5B8C"
                         LineBreakMode="TailTruncation"
                         MaxLines="1"/>
                </VerticalStackLayout>
              </Grid>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
        
        <!-- Empty State -->
        <CollectionView.EmptyView>
          <VerticalStackLayout Padding="20"
                               Spacing="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
            <Label Text="🐾"
                   FontSize="48"
                   HorizontalOptions="Center"/>
            <Label Text="No pets found"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#2D1B4E"
                   HorizontalOptions="Center"/>
            <Label Text="Try adjusting your search"
                   FontSize="12"
                   TextColor="#6B5B8C"
                   HorizontalOptions="Center"/>
          </VerticalStackLayout>
        </CollectionView.EmptyView>
      </CollectionView>

      <!-- Products Grid -->
      <CollectionView ItemsSource="{Binding Products}"
                      IsVisible="{Binding IsProductsSectionActive}"
                      Margin="12,12,12,12">
        <CollectionView.ItemsLayout>
          <GridItemsLayout Orientation="Vertical"
                           HorizontalItemSpacing="10"
                           VerticalItemSpacing="12"
                           Span="2"/>
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
          <DataTemplate>
            <VerticalStackLayout Spacing="0">
              <Border StrokeShape="RoundRectangle 12,12,12,12"
                      Stroke="#DDD2FF"
                      StrokeThickness="1"
                      BackgroundColor="White"
                      Padding="0">
                <VerticalStackLayout Spacing="0" Padding="0">
                  <!-- Product Image -->
                  <Image Source="dotnet_bot.png"
                         Aspect="AspectFill"
                         HeightRequest="140"/>

                  <!-- Product Details -->
                  <VerticalStackLayout Padding="12" Spacing="6">
                    <!-- Product Name -->
                    <Label Text="{Binding Name}"
                           FontSize="13"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation"
                           MaxLines="2"
                           TextColor="#2D1B4E"/>

                    <!-- Product Price -->
                    <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#B19CD9"/>

                    <!-- View Details Button -->
                    <Button Text="View Details"
                            BackgroundColor="#B19CD9"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="0,8"
                            FontSize="11"
                            FontAttributes="Bold"
                            Margin="0,4,0,0"/>
                  </VerticalStackLayout>
                </VerticalStackLayout>
              </Border>
            </VerticalStackLayout>
          </DataTemplate>
        </CollectionView.ItemTemplate>

        <!-- Empty State -->
        <CollectionView.EmptyView>
          <VerticalStackLayout Padding="20"
                               Spacing="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
            <Label Text="🛍️"
                   FontSize="48"
                   HorizontalOptions="Center"/>
            <Label Text="No products found"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#2D1B4E"
                   HorizontalOptions="Center"/>
            <Label Text="Try adjusting your search"
                   FontSize="12"
                   TextColor="#6B5B8C"
                   HorizontalOptions="Center"/>
          </VerticalStackLayout>
        </CollectionView.EmptyView>
      </CollectionView>
    </Grid>
  </Grid>
</ContentPage>