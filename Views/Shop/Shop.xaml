<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="floofy.Views.Shop"
             Title="Shop"
             NavigationPage.HasNavigationBar="False">

  <Grid BackgroundColor="#F8F7FC"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="0"
        Padding="0">

    <!-- Header with Background Image -->
    <Grid Grid.Row="0"
          HeightRequest="150">
      <!-- Background Image -->
      <Image Source="shop_bg.jpg"
             Aspect="AspectFill"
             VerticalOptions="Fill"
             HorizontalOptions="Fill"
             Opacity="1"/>

      <!-- Header Content -->
      <VerticalStackLayout Padding="24,20,24,12"
                           Spacing="4"
                           VerticalOptions="Center">
        <Label Text="Shop"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="White"/>
        <Label Text="Browse and discover amazing products"
               FontSize="12"
               TextColor="#E8E0F5"
               LineBreakMode="WordWrap"/>
      </VerticalStackLayout>
    </Grid>

    <!-- Tab Selector with Indicator -->
    <Grid Grid.Row="1"
          Padding="24,12,24,0"
          ColumnDefinitions="Auto,Auto,*"
          RowDefinitions="Auto,Auto"
          ColumnSpacing="24">
      <Button Grid.Column="0"
              Grid.Row="0"
              Text="🐾 Pets"
              x:Name="PetsTabButton"
              Clicked="OnPetsTabClicked"
              BackgroundColor="Transparent"
              TextColor="#2D1B4E"
              FontAttributes="Bold"
              FontSize="14"
              Padding="0"
              HorizontalOptions="Start"/>
      <Button Grid.Column="1"
              Grid.Row="0"
              Text="🛍️ Products"
              x:Name="ProductsTabButton"
              Clicked="OnProductsTabClicked"
              BackgroundColor="Transparent"
              TextColor="#6B5B8C"
              FontSize="14"
              Padding="0"
              HorizontalOptions="Start"/>

      <!-- Tab Indicator Line -->
      <BoxView Grid.Column="0"
               Grid.Row="1"
               x:Name="TabIndicator"
               Color="#B19CD9"
               HeightRequest="3"
               WidthRequest="58"
               HorizontalOptions="Start"
               Margin="0,8,0,0"/>
    </Grid>

    <!-- Search Bar -->
    <VerticalStackLayout Grid.Row="2"
                         Padding="24,12,24,0"
                         Spacing="8">
      <SearchBar x:Name="SearchBar"
                 Placeholder="Search products or pets..."
                 Text="{Binding SearchQuery}"
                 SearchButtonPressed="OnSearchButtonPressed"
                 IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                 PlaceholderColor="#A89BBB"
                 TextColor="#2D1B4E"
                 BackgroundColor="White"
                 CancelButtonColor="#6B5B8C"/>
      <Label Text="{Binding ErrorMessage}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource StringBoolConverter}}"
             TextColor="#FF6B6B"
             FontAttributes="Bold"
             FontSize="12"/>
    </VerticalStackLayout>

    <!-- Content -->
    <Grid Grid.Row="3">

      <ActivityIndicator IsRunning="{Binding IsLoading}"
                         IsVisible="{Binding IsLoading}"
                         Color="#B19CD9"
                         VerticalOptions="Center"
                         HorizontalOptions="Center"
                         Margin="0,20,0,0"/>

      <!-- Pets List -->
      <CollectionView ItemsSource="{Binding Pets}"
                      IsVisible="{Binding IsPetsSectionActive}"
                      Margin="24,12,24,12">
        <CollectionView.ItemsLayout>
          <LinearItemsLayout Orientation="Vertical"
                             ItemSpacing="12"/>
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <Border StrokeShape="RoundRectangle 12,12,12,12"
                    Stroke="#DDD2FF"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="0">
              <Grid ColumnDefinitions="100,*"
                  ColumnSpacing="12"
                  Padding="12">
                <!-- Pet Image -->
                <Image Grid.Column="0"
                       Source="dotnet_bot.png"
                       HeightRequest="100"
                       WidthRequest="100"
                       Aspect="AspectFill"/>

                <!-- Pet Details -->
                <VerticalStackLayout Grid.Column="1"
                    Spacing="4">
                  <Label Text="{Binding Name}"
                         FontSize="15"
                         FontAttributes="Bold"
                         TextColor="#2D1B4E"/>
                  <Label Text="{Binding Species}"
                         FontSize="11"
                         TextColor="#6B5B8C"/>
                  <Label Text="{Binding Breed}"
                         FontSize="11"
                         TextColor="#6B5B8C"/>
                  <Label Text="{Binding Age, StringFormat='Age: {0} year(s)'}"
                         FontSize="11"
                         TextColor="#6B5B8C"/>
                  <Label Text="{Binding Description}"
                         FontSize="11"
                         TextColor="#6B5B8C"
                         LineBreakMode="TailTruncation"
                         MaxLines="1"/>
                </VerticalStackLayout>

                <!-- View Details Button -->
                <Button Grid.Row="1"
                        Text="View Details"
                        Clicked="OnPetViewDetailsClicked"
                        BackgroundColor="#B19CD9"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="0,8"
                        FontSize="11"
                        FontAttributes="Bold"/>
              </Grid>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>

        <!-- Empty State -->
        <CollectionView.EmptyView>
          <VerticalStackLayout Padding="20"
                               Spacing="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
            <Label Text="🐾"
                   FontSize="48"
                   HorizontalOptions="Center"/>
            <Label Text="No pets found"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#2D1B4E"
                   HorizontalOptions="Center"/>
            <Label Text="Try adjusting your search"
                   FontSize="12"
                   TextColor="#6B5B8C"
                   HorizontalOptions="Center"/>
          </VerticalStackLayout>
        </CollectionView.EmptyView>
      </CollectionView>

      <!-- Products Grid -->
      <CollectionView ItemsSource="{Binding Products}"
                      IsVisible="{Binding IsProductsSectionActive}"
                      Margin="12,12,12,12">
        <CollectionView.ItemsLayout>
          <GridItemsLayout Orientation="Vertical"
                           HorizontalItemSpacing="10"
                           VerticalItemSpacing="12"
                           Span="2"/>
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
          <DataTemplate>
            <VerticalStackLayout Spacing="0">
              <Border StrokeShape="RoundRectangle 12,12,12,12"
                      Stroke="#DDD2FF"
                      StrokeThickness="1"
                      BackgroundColor="White"
                      Padding="0">
                <VerticalStackLayout Spacing="0"
                    Padding="0">
                  <!-- Product Image -->
                  <Image Source="dotnet_bot.png"
                         Aspect="AspectFill"
                         HeightRequest="140"/>

                  <!-- Product Details -->
                  <VerticalStackLayout Padding="12"
                      Spacing="6">
                    <!-- Product Name -->
                    <Label Text="{Binding Name}"
                           FontSize="13"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation"
                           MaxLines="2"
                           TextColor="#2D1B4E"/>

                    <!-- Product Price -->
                    <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#B19CD9"/>

                    <!-- View Details Button -->
                    <Button Text="View Details"
                            BackgroundColor="#B19CD9"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="0,8"
                            FontSize="11"
                            FontAttributes="Bold"
                            Margin="0,4,0,0"/>
                  </VerticalStackLayout>
                </VerticalStackLayout>
              </Border>
            </VerticalStackLayout>
          </DataTemplate>
        </CollectionView.ItemTemplate>

        <!-- Empty State -->
        <CollectionView.EmptyView>
          <VerticalStackLayout Padding="20"
                               Spacing="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
            <Label Text="🛍️"
                   FontSize="48"
                   HorizontalOptions="Center"/>
            <Label Text="No products found"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#2D1B4E"
                   HorizontalOptions="Center"/>
            <Label Text="Try adjusting your search"
                   FontSize="12"
                   TextColor="#6B5B8C"
                   HorizontalOptions="Center"/>
          </VerticalStackLayout>
        </CollectionView.EmptyView>
      </CollectionView>
    </Grid>
  </Grid>
</ContentPage>
