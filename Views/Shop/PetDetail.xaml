<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="floofy.Views.PetDetail"
             Title="Pet Details"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

  <Grid BackgroundColor="#F8F7FC"
        RowDefinitions="*,Auto"
        RowSpacing="0">

    <!-- Scrollable content -->
    <ScrollView Grid.Row="0">
      <Grid RowDefinitions="Auto,Auto"
            RowSpacing="0">

        <!-- Hero image with overlays -->
        <Grid Grid.Row="0"
              HeightRequest="300">
          <Image Source="{Binding Pet.Thumbnail, Converter={StaticResource ImageOrPlaceholderConverter}}"
                 Aspect="AspectFill"
                 VerticalOptions="Fill"
                 HorizontalOptions="Fill"/>

          <!-- Back chip -->
          <Button Text="←"
                  Clicked="OnBackClicked"
                  BackgroundColor="#E6FFFFFF"
                  TextColor="#2D1B4E"
                  FontSize="20"
                  FontAttributes="Bold"
                  BorderWidth="0"
                  CornerRadius="20"
                  WidthRequest="40"
                  HeightRequest="40"
                  Padding="8,4,8,10"
                  Margin="16,16,0,0"
                  HorizontalOptions="Start"
                  VerticalOptions="Start"/>

          <!-- Vaccinated badge -->
          <Border IsVisible="{Binding Pet.Vaccinated}"
                  StrokeShape="RoundRectangle 10,10,10,10"
                  BackgroundColor="#4CAF93"
                  Stroke="Transparent"
                  Padding="10,4"
                  Margin="0,16,16,0"
                  HorizontalOptions="End"
                  VerticalOptions="Start">
            <Label Text="💉 Vaccinated"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="White"/>
          </Border>
        </Grid>

        <!-- Detail body -->
        <Grid Grid.Row="1">

          <!-- Loading -->
          <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             Color="#B19CD9"
                             VerticalOptions="Start"
                             HorizontalOptions="Center"
                             Margin="0,40,0,0"/>

          <VerticalStackLayout Padding="20,18,20,28"
                               Spacing="16"
                               IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">

            <!-- Error -->
            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringBoolConverter}}"
                   TextColor="#FF6B6B"
                   FontAttributes="Bold"
                   FontSize="13"/>

            <!-- Title + species/breed chips -->
            <VerticalStackLayout Spacing="8">
              <Label Text="{Binding Pet.Name}"
                     FontSize="22"
                     FontAttributes="Bold"
                     TextColor="#2D1B4E"
                     LineBreakMode="WordWrap"/>

              <HorizontalStackLayout Spacing="6">
                <Border StrokeShape="RoundRectangle 10,10,10,10"
                        Stroke="#DDD2FF"
                        StrokeThickness="1"
                        BackgroundColor="#F0EAFB"
                        Padding="10,4">
                  <Label Text="{Binding Pet.Species}"
                         FontSize="11"
                         FontAttributes="Bold"
                         TextColor="#6B5B8C"/>
                </Border>
                <Border StrokeShape="RoundRectangle 10,10,10,10"
                        Stroke="#DDD2FF"
                        StrokeThickness="1"
                        BackgroundColor="#F0EAFB"
                        Padding="10,4">
                  <Label Text="{Binding Pet.Breed}"
                         FontSize="11"
                         FontAttributes="Bold"
                         TextColor="#6B5B8C"/>
                </Border>
              </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Quick stats card -->
            <Border StrokeShape="RoundRectangle 14,14,14,14"
                    Stroke="#DDD2FF"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16,14">
              <Border.Shadow>
                <Shadow Brush="#10000000"
                        Offset="0,2"
                        Radius="6"/>
              </Border.Shadow>
              <Grid ColumnDefinitions="*,*,*"
                    ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0"
                                     Spacing="4"
                                     HorizontalOptions="Center">
                  <Label Text="📅"
                         FontSize="22"
                         HorizontalOptions="Center"/>
                  <Label Text="{Binding Pet.Age, StringFormat='{0} yr'}"
                         FontSize="14"
                         FontAttributes="Bold"
                         TextColor="#2D1B4E"
                         HorizontalOptions="Center"/>
                  <Label Text="Age"
                         FontSize="11"
                         TextColor="#6B5B8C"
                         HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="4"
                                     HorizontalOptions="Center">
                  <Label Text="⚧"
                         FontSize="22"
                         HorizontalOptions="Center"/>
                  <Label Text="{Binding Pet.Gender}"
                         FontSize="14"
                         FontAttributes="Bold"
                         TextColor="#2D1B4E"
                         HorizontalOptions="Center"/>
                  <Label Text="Gender"
                         FontSize="11"
                         TextColor="#6B5B8C"
                         HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2"
                                     Spacing="4"
                                     HorizontalOptions="Center">
                  <Label Text="⚖️"
                         FontSize="22"
                         HorizontalOptions="Center"/>
                  <Label Text="{Binding Pet.Weight, StringFormat='{0} kg'}"
                         FontSize="14"
                         FontAttributes="Bold"
                         TextColor="#2D1B4E"
                         HorizontalOptions="Center"/>
                  <Label Text="Weight"
                         FontSize="11"
                         TextColor="#6B5B8C"
                         HorizontalOptions="Center"/>
                </VerticalStackLayout>
              </Grid>
            </Border>

            <!-- About card -->
            <Border StrokeShape="RoundRectangle 14,14,14,14"
                    Stroke="#DDD2FF"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16,14">
              <VerticalStackLayout Spacing="8">
                <Label Text="About"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#2D1B4E"/>
                <Label Text="{Binding Pet.Description}"
                       FontSize="13"
                       TextColor="#6B5B8C"
                       LineBreakMode="WordWrap"/>
              </VerticalStackLayout>
            </Border>

            <!-- Health & Details card -->
            <Border StrokeShape="RoundRectangle 14,14,14,14"
                    Stroke="#DDD2FF"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16,14">
              <VerticalStackLayout Spacing="10">
                <Label Text="Health &amp; Details"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#2D1B4E"/>

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">
                  <Label Grid.Column="0"
                         Text="📏"
                         FontSize="14"
                         VerticalOptions="Center"/>
                  <Label Grid.Column="1"
                         Text="Height"
                         FontSize="13"
                         TextColor="#6B5B8C"
                         VerticalOptions="Center"/>
                  <Label Grid.Column="2"
                         Text="{Binding Pet.Height, StringFormat='{0} cm'}"
                         FontSize="13"
                         FontAttributes="Bold"
                         TextColor="#2D1B4E"
                         VerticalOptions="Center"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">
                  <Label Grid.Column="0"
                         Text="💉"
                         FontSize="14"
                         VerticalOptions="Center"/>
                  <Label Grid.Column="1"
                         Text="Vaccinated"
                         FontSize="13"
                         TextColor="#6B5B8C"
                         VerticalOptions="Center"/>
                  <Label Grid.Column="2"
                         Text="{Binding Pet.Vaccinated}"
                         FontSize="13"
                         FontAttributes="Bold"
                         TextColor="#B19CD9"
                         VerticalOptions="Center"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">
                  <Label Grid.Column="0"
                         Text="🩺"
                         FontSize="14"
                         VerticalOptions="Center"/>
                  <Label Grid.Column="1"
                         Text="Neutered"
                         FontSize="13"
                         TextColor="#6B5B8C"
                         VerticalOptions="Center"/>
                  <Label Grid.Column="2"
                         Text="{Binding Pet.Neutered}"
                         FontSize="13"
                         FontAttributes="Bold"
                         TextColor="#B19CD9"
                         VerticalOptions="Center"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10"
                      IsVisible="{Binding Pet.HealthCertificate, Converter={StaticResource StringBoolConverter}}">
                  <Label Grid.Column="0"
                         Text="📄"
                         FontSize="14"
                         VerticalOptions="Start"/>
                  <VerticalStackLayout Grid.Column="1"
                                       Spacing="2">
                    <Label Text="Health Certificate"
                           FontSize="13"
                           TextColor="#6B5B8C"/>
                    <Label Text="{Binding Pet.HealthCertificate}"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#2D1B4E"
                           LineBreakMode="WordWrap"/>
                  </VerticalStackLayout>
                </Grid>
              </VerticalStackLayout>
            </Border>

            <!-- Status message -->
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringBoolConverter}}"
                   TextColor="#4CAF93"
                   FontAttributes="Bold"
                   FontSize="12"/>

          </VerticalStackLayout>
        </Grid>
      </Grid>
    </ScrollView>

    <!-- Sticky Adopt-Pet bar -->
    <Border Grid.Row="1"
            BackgroundColor="White"
            Stroke="#E5DCFB"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 0,0,0,0"
            Padding="16,12"
            IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="12">

        <VerticalStackLayout Grid.Column="0"
                             Spacing="0"
                             VerticalOptions="Center">
          <Label Text="Adoption fee"
                 FontSize="10"
                 TextColor="#6B5B8C"/>
          <Label Text="{Binding AdoptionFee, StringFormat='${0:F2}'}"
                 FontSize="16"
                 FontAttributes="Bold"
                 TextColor="#2D1B4E"/>
        </VerticalStackLayout>

        <Button Grid.Column="1"
                Text="{Binding AdoptButtonText}"
                BackgroundColor="#B19CD9"
                TextColor="White"
                CornerRadius="12"
                FontSize="13"
                FontAttributes="Bold"
                Padding="20,0"
                HeightRequest="44"
                Command="{Binding AdoptCommand}"
                IsEnabled="{Binding CanAdopt}"/>
      </Grid>
    </Border>

  </Grid>
</ContentPage>
