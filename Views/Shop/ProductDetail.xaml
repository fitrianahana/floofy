<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="floofy.Views.ProductDetail"
             Title="Product Details"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

  <Grid BackgroundColor="#F8F7FC"
        RowDefinitions="*,Auto"
        RowSpacing="0">

    <!-- Scrollable content (image + details) -->
    <ScrollView Grid.Row="0">
      <Grid RowDefinitions="Auto,Auto"
            RowSpacing="0">

        <!-- Hero image with overlays -->
        <Grid Grid.Row="0"
              HeightRequest="300">
          <Image Source="{Binding Product.Thumbnail}"
                 Aspect="AspectFill"
                 VerticalOptions="Fill"
                 HorizontalOptions="Fill"/>

          <!-- Back chip -->
          <Button Text="←"
                  Clicked="OnBackClicked"
                  BackgroundColor="#E6FFFFFF"
                  TextColor="#2D1B4E"
                  FontSize="20"
                  FontAttributes="Bold"
                  BorderWidth="0"
                  CornerRadius="20"
                  WidthRequest="40"
                  HeightRequest="40"
                  Padding="8,4,8,10"
                  Margin="16,16,0,0"
                  HorizontalOptions="Start"
                  VerticalOptions="Start"/>

          <!-- Discount ribbon -->
          <Border IsVisible="{Binding Product.HasDiscount}"
                  StrokeShape="RoundRectangle 10,10,10,10"
                  BackgroundColor="#FF6B6B"
                  Stroke="Transparent"
                  Padding="10,4"
                  Margin="0,16,16,0"
                  HorizontalOptions="End"
                  VerticalOptions="Start">
            <Label Text="{Binding Product.Discount, StringFormat='-{0:F0}% OFF'}"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="White"/>
          </Border>
        </Grid>

        <!-- Detail body -->
        <Grid Grid.Row="1">

          <!-- Loading -->
          <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             Color="#B19CD9"
                             VerticalOptions="Start"
                             HorizontalOptions="Center"
                             Margin="0,40,0,0"/>

          <VerticalStackLayout Padding="20,18,20,24"
                               Spacing="16"
                               IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">

            <!-- Error -->
            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringBoolConverter}}"
                   TextColor="#FF6B6B"
                   FontAttributes="Bold"
                   FontSize="13"/>

            <!-- Title + rating -->
            <VerticalStackLayout Spacing="6">
              <Label Text="{Binding Product.Name}"
                     FontSize="22"
                     FontAttributes="Bold"
                     TextColor="#2D1B4E"
                     LineBreakMode="WordWrap"/>

              <HorizontalStackLayout Spacing="6">
                <Label Text="{Binding Product.Rating, Converter={StaticResource RatingToStarsConverter}}"
                       FontSize="13"
                       TextColor="#F5B301"/>
                <Label Text="{Binding Product.Rating, StringFormat='{0}.0 rating'}"
                       FontSize="11"
                       TextColor="#6B5B8C"
                       VerticalOptions="Center"/>
              </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Price card -->
            <Border StrokeShape="RoundRectangle 14,14,14,14"
                    Stroke="#DDD2FF"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16,14">
              <Grid ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0"
                                     Spacing="2">
                  <Label Text="Price"
                         FontSize="11"
                         TextColor="#6B5B8C"
                         FontAttributes="Bold"/>
                  <HorizontalStackLayout Spacing="8">
                    <Label Text="{Binding Product.DiscountedPrice, StringFormat='${0:F2}'}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#B19CD9"/>
                    <Label Text="{Binding Product.Price, StringFormat='${0:F2}'}"
                           FontSize="13"
                           TextColor="#A89BBB"
                           TextDecorations="Strikethrough"
                           VerticalOptions="Center"
                           IsVisible="{Binding Product.HasDiscount}"/>
                  </HorizontalStackLayout>
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        BackgroundColor="#F0EAFB"
                        Stroke="Transparent"
                        Padding="10,6"
                        VerticalOptions="Center">
                  <Label Text="{Binding Product.StockQuantity, Converter={StaticResource StockToLabelConverter}}"
                         TextColor="{Binding Product.StockQuantity, Converter={StaticResource StockToColorConverter}}"
                         FontSize="11"
                         FontAttributes="Bold"/>
                </Border>
              </Grid>
            </Border>

            <!-- Description -->
            <Border StrokeShape="RoundRectangle 14,14,14,14"
                    Stroke="#DDD2FF"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16,14">
              <VerticalStackLayout Spacing="8">
                <Label Text="Description"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#2D1B4E"/>
                <Label Text="{Binding Product.Description}"
                       FontSize="13"
                       TextColor="#6B5B8C"
                       LineBreakMode="WordWrap"/>
              </VerticalStackLayout>
            </Border>

            <!-- Details -->
            <Border StrokeShape="RoundRectangle 14,14,14,14"
                    Stroke="#DDD2FF"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="16,14">
              <VerticalStackLayout Spacing="10">
                <Label Text="Product Details"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#2D1B4E"/>

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">
                  <Label Grid.Column="0"
                         Text="🏷️"
                         FontSize="14"
                         VerticalOptions="Center"/>
                  <Label Grid.Column="1"
                         Text="SKU"
                         FontSize="13"
                         TextColor="#6B5B8C"
                         VerticalOptions="Center"/>
                  <Label Grid.Column="2"
                         Text="{Binding Product.Sku}"
                         FontSize="13"
                         FontAttributes="Bold"
                         TextColor="#2D1B4E"
                         VerticalOptions="Center"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">
                  <Label Grid.Column="0"
                         Text="📦"
                         FontSize="14"
                         VerticalOptions="Center"/>
                  <Label Grid.Column="1"
                         Text="Available stock"
                         FontSize="13"
                         TextColor="#6B5B8C"
                         VerticalOptions="Center"/>
                  <Label Grid.Column="2"
                         Text="{Binding Product.StockQuantity, StringFormat='{0} units'}"
                         FontSize="13"
                         FontAttributes="Bold"
                         TextColor="#2D1B4E"
                         VerticalOptions="Center"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10"
                      IsVisible="{Binding Product.HasDiscount}">
                  <Label Grid.Column="0"
                         Text="💸"
                         FontSize="14"
                         VerticalOptions="Center"/>
                  <Label Grid.Column="1"
                         Text="You save"
                         FontSize="13"
                         TextColor="#6B5B8C"
                         VerticalOptions="Center"/>
                  <Label Grid.Column="2"
                         Text="{Binding Product.Discount, StringFormat='{0:F0}%'}"
                         FontSize="13"
                         FontAttributes="Bold"
                         TextColor="#FF6B6B"
                         VerticalOptions="Center"/>
                </Grid>
              </VerticalStackLayout>
            </Border>

            <!-- Status message -->
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringBoolConverter}}"
                   TextColor="#4CAF93"
                   FontAttributes="Bold"
                   FontSize="12"/>

          </VerticalStackLayout>
        </Grid>
      </Grid>
    </ScrollView>

    <!-- Sticky Add-to-Cart bar -->
    <Border Grid.Row="1"
            BackgroundColor="White"
            Stroke="#E5DCFB"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 0,0,0,0"
            Padding="16,12"
            IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
      <Grid ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12">

        <!-- Quantity stepper -->
        <Border Grid.Column="0"
                StrokeShape="RoundRectangle 12,12,12,12"
                Stroke="#DDD2FF"
                StrokeThickness="1"
                BackgroundColor="#F0EAFB"
                Padding="0"
                VerticalOptions="Center">
          <Grid ColumnDefinitions="36,Auto,36"
                HeightRequest="40">
            <Button Grid.Column="0"
                    Text="−"
                    FontSize="18"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    TextColor="#6B5B8C"
                    Padding="0"
                    BorderWidth="0"
                    Command="{Binding DecrementQuantityCommand}"/>
            <Label Grid.Column="1"
                   Text="{Binding Quantity}"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#2D1B4E"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   MinimumWidthRequest="22"/>
            <Button Grid.Column="2"
                    Text="+"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    TextColor="#6B5B8C"
                    Padding="0"
                    BorderWidth="0"
                    Command="{Binding IncrementQuantityCommand}"/>
          </Grid>
        </Border>

        <!-- Total -->
        <VerticalStackLayout Grid.Column="1"
                             Spacing="0"
                             VerticalOptions="Center">
          <Label Text="Total"
                 FontSize="10"
                 TextColor="#6B5B8C"/>
          <Label Text="{Binding LineTotal, StringFormat='${0:F2}'}"
                 FontSize="16"
                 FontAttributes="Bold"
                 TextColor="#2D1B4E"/>
        </VerticalStackLayout>

        <!-- Add to cart -->
        <Button Grid.Column="2"
                Text="Add to Cart"
                BackgroundColor="#B19CD9"
                TextColor="White"
                CornerRadius="12"
                FontSize="13"
                FontAttributes="Bold"
                Padding="20,0"
                HeightRequest="44"
                Command="{Binding AddToCartCommand}"
                IsEnabled="{Binding CanAddToCart}"/>
      </Grid>
    </Border>

  </Grid>
</ContentPage>
