<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="floofy.Views.RehomingAgreement"
             Title="Rehoming Agreement"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

  <Grid BackgroundColor="#F8F7FC"
        RowDefinitions="Auto,*"
        RowSpacing="0">

    <!-- Header -->
    <Grid Grid.Row="0"
          ColumnDefinitions="Auto,*"
          Padding="12,16,16,12"
          ColumnSpacing="6"
          BackgroundColor="White">

      <Button Grid.Column="0"
              Text="←"
              Clicked="OnBackClicked"
              BackgroundColor="Transparent"
              TextColor="#2D1B4E"
              FontSize="20"
              FontAttributes="Bold"
              BorderWidth="0"
              CornerRadius="20"
              WidthRequest="40"
              HeightRequest="40"
              Padding="8,4,8,10"/>

      <VerticalStackLayout Grid.Column="1"
                           Spacing="2"
                           VerticalOptions="Center">
        <Label Text="Rehoming Agreement"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="#2D1B4E"/>
        <Label Text="Please read carefully"
               FontSize="11"
               TextColor="#6B5B8C"/>
      </VerticalStackLayout>
    </Grid>

    <ScrollView Grid.Row="1">
      <VerticalStackLayout Padding="20,18,20,28"
                           Spacing="16">

        <!-- Intro card -->
        <Border StrokeShape="RoundRectangle 14,14,14,14"
                Stroke="#DDD2FF"
                StrokeThickness="1"
                BackgroundColor="#F0EAFB"
                Padding="16,14">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="14">
            <Label Grid.Column="0"
                   Text="📜"
                   FontSize="32"
                   VerticalOptions="Center"/>
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2"
                                 VerticalOptions="Center">
              <Label Text="Auto-accepted on submission"
                     FontSize="13"
                     FontAttributes="Bold"
                     TextColor="#2D1B4E"/>
              <Label Text="By listing your pet, you confirm you have read and accept the terms below."
                     FontSize="11"
                     TextColor="#6B5B8C"
                     LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
          </Grid>
        </Border>

        <!-- Section 1 -->
        <Border StrokeShape="RoundRectangle 14,14,14,14"
                Stroke="#DDD2FF"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="16,14">
          <VerticalStackLayout Spacing="8">
            <Label Text="1. Ownership and Authority"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#2D1B4E"/>
            <Label Text="You confirm that you are the lawful owner of the pet, or that you are authorised by the lawful owner to list this pet for rehoming on Floofy. The information you provide is accurate and complete to the best of your knowledge."
                   FontSize="12"
                   TextColor="#6B5B8C"
                   LineBreakMode="WordWrap"/>
          </VerticalStackLayout>
        </Border>

        <!-- Section 2 -->
        <Border StrokeShape="RoundRectangle 14,14,14,14"
                Stroke="#DDD2FF"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="16,14">
          <VerticalStackLayout Spacing="8">
            <Label Text="2. Welfare First"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#2D1B4E"/>
            <Label Text="The pet's wellbeing is paramount. You agree to disclose any known medical, behavioural, or temperament issues, and to continue caring for the pet in accordance with applicable animal-welfare laws until the rehoming is completed."
                   FontSize="12"
                   TextColor="#6B5B8C"
                   LineBreakMode="WordWrap"/>
          </VerticalStackLayout>
        </Border>

        <!-- Section 3 -->
        <Border StrokeShape="RoundRectangle 14,14,14,14"
                Stroke="#DDD2FF"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="16,14">
          <VerticalStackLayout Spacing="8">
            <Label Text="3. Rehoming Fee"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#2D1B4E"/>
            <Label Text="Any fee you set is intended to help offset reasonable costs of care, vaccinations, and transfer. Fees are not a sale price and Floofy does not facilitate the commercial breeding or trading of animals."
                   FontSize="12"
                   TextColor="#6B5B8C"
                   LineBreakMode="WordWrap"/>
          </VerticalStackLayout>
        </Border>

        <!-- Section 4 -->
        <Border StrokeShape="RoundRectangle 14,14,14,14"
                Stroke="#DDD2FF"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="16,14">
          <VerticalStackLayout Spacing="8">
            <Label Text="4. Adopter Screening"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#2D1B4E"/>
            <Label Text="You agree to assess interested adopters in good faith and to decline any applicant whose situation appears unsuitable for the pet. Floofy may, at its discretion, remove listings that violate these expectations."
                   FontSize="12"
                   TextColor="#6B5B8C"
                   LineBreakMode="WordWrap"/>
          </VerticalStackLayout>
        </Border>

        <!-- Section 5 -->
        <Border StrokeShape="RoundRectangle 14,14,14,14"
                Stroke="#DDD2FF"
                StrokeThickness="1"
                BackgroundColor="White"
                Padding="16,14">
          <VerticalStackLayout Spacing="8">
            <Label Text="5. Withdrawal and Updates"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#2D1B4E"/>
            <Label Text="You may withdraw a listing at any time before an adopter has confirmed transfer. Material changes (health updates, prior reservations elsewhere, etc.) must be reflected on the listing without delay."
                   FontSize="12"
                   TextColor="#6B5B8C"
                   LineBreakMode="WordWrap"/>
          </VerticalStackLayout>
        </Border>

        <!-- Acknowledge button -->
        <Button Text="I Understand"
                Clicked="OnUnderstandClicked"
                BackgroundColor="#B19CD9"
                TextColor="White"
                CornerRadius="12"
                FontSize="13"
                FontAttributes="Bold"
                Padding="24,0"
                HeightRequest="46"
                Margin="0,4,0,0"/>

        <!-- Footer note -->
        <Label Text="This summary supplements (and does not replace) Floofy's general Terms of Service."
               FontSize="11"
               FontAttributes="Italic"
               TextColor="#A89BBB"
               HorizontalTextAlignment="Center"
               LineBreakMode="WordWrap"
               Margin="0,4,0,0"/>
      </VerticalStackLayout>
    </ScrollView>
  </Grid>
</ContentPage>
