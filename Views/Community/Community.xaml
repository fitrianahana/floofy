<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:floofy.Models"
             x:Class="floofy.Views.Community"
             Title="Community">
  <Grid RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="8"
        Padding="0">
    <!-- Header -->
    <VerticalStackLayout Grid.Row="0"
                         Padding="16,16,16,8"
                         Spacing="4"
                         BackgroundColor="#F5F5F5">
      <Label Text="Community"
             FontSize="24"
             FontAttributes="Bold"/>
      <Label Text="Connect with pet lovers and join events"
             FontSize="13"
             TextColor="Gray"/>
    </VerticalStackLayout>
    <!-- Status -->
    <VerticalStackLayout Grid.Row="1"
                         Padding="16,0,16,0"
                         Spacing="6">
      <ActivityIndicator IsRunning="{Binding IsLoading}"
                         IsVisible="{Binding IsLoading}"
                         Color="{StaticResource Primary}"/>
      <Label Text="{Binding ErrorMessage}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource StringBoolConverter}}"
             TextColor="Red"
             FontAttributes="Bold"/>
    </VerticalStackLayout>
    <!-- Create Post -->
    <Border Grid.Row="2"
            Margin="12,0,12,0"
            Stroke="{StaticResource Primary}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 10,10,10,10"
            Padding="12">
      <VerticalStackLayout Spacing="8">
        <Label Text="Create a Post"
               FontAttributes="Bold"
               FontSize="16"/>
        <Entry Placeholder="Post title"
               Text="{Binding NewPostTitle}"
               IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
        <Editor Placeholder="Share something with the community..."
                AutoSize="TextChanges"
                HeightRequest="90"
                Text="{Binding NewPostContent}"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
        <Button Text="Post"
                Command="{Binding CreatePostCommand}"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
      </VerticalStackLayout>
    </Border>
    <!-- Main Content -->
    <ScrollView Grid.Row="3">
      <VerticalStackLayout Padding="12,8,12,16"
                           Spacing="16">
        <!-- Posts -->
        <VerticalStackLayout Spacing="8">
          <Label Text="Recent Posts"
                 FontSize="18"
                 FontAttributes="Bold"/>
          <CollectionView ItemsSource="{Binding Posts}"
                          SelectionMode="None">
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="models:Post">
                <Border Stroke="#DDDDDD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Padding="10"
                        Margin="0,0,0,8">
                  <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Title}"
                           FontAttributes="Bold"
                           FontSize="15"/>
                    <Label Text="{Binding Content}"
                           FontSize="13"
                           TextColor="#444444"/>
                    <HorizontalStackLayout Spacing="12">
                      <Label Text="{Binding LikeCount, StringFormat='Likes: {0}'}"
                             FontSize="12"
                             TextColor="Gray"/>
                      <Label Text="{Binding CommentCount, StringFormat='Comments: {0}'}"
                             FontSize="12"
                             TextColor="Gray"/>
                    </HorizontalStackLayout>
                  </VerticalStackLayout>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
              <Label Text="No posts yet."
                     TextColor="Gray"
                     HorizontalOptions="Center"
                     Margin="0,8,0,0"/>
            </CollectionView.EmptyView>
          </CollectionView>
        </VerticalStackLayout>
        <!-- Events -->
        <VerticalStackLayout Spacing="8">
          <Label Text="Upcoming Events"
                 FontSize="18"
                 FontAttributes="Bold"/>
          <CollectionView ItemsSource="{Binding Events}"
                          SelectionMode="None">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <Border Stroke="#DDDDDD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10,10,10,10"
                        Padding="10"
                        Margin="0,0,0,8">
                  <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding Name}"
                           FontAttributes="Bold"
                           FontSize="15"/>
                    <Label Text="{Binding Description}"
                           FontSize="13"
                           TextColor="#444444"/>
                    <Label Text="{Binding EventDate, StringFormat='Date: {0:MMM dd, yyyy hh:mm tt}'}"
                           FontSize="12"
                           TextColor="Gray"/>
                    <Label Text="{Binding Location, StringFormat='Location: {0}'}"
                           FontSize="12"
                           TextColor="Gray"/>
                    <Button Text="{Binding RsvpButtonText}"
                            IsEnabled="{Binding CanRsvp}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RSVPAttendingCommand}"
                            CommandParameter="{Binding EventId}"/>
                  </VerticalStackLayout>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
              <Label Text="No events available."
                     TextColor="Gray"
                     HorizontalOptions="Center"
                     Margin="0,8,0,0"/>
            </CollectionView.EmptyView>
          </CollectionView>
        </VerticalStackLayout>
      </VerticalStackLayout>
    </ScrollView>
  </Grid>
</ContentPage>
