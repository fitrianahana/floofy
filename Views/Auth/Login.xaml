<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="floofy.Views.Login"
             Title="Login"
             NavigationPage.HasNavigationBar="False">
  <Grid>
    <Image Source="login_bg.jpg"
           Aspect="AspectFill"
           HorizontalOptions="Fill"
           VerticalOptions="Fill"
           Opacity="1" />

    <Grid Padding="24,22,24,20" RowDefinitions="Auto,*">
      <Image Grid.Row="0"
             Source="floofy_logo.png"
             HeightRequest="230"
             WidthRequest="230"
             HorizontalOptions="Center"
             Margin="0,-35,0,2"
             Aspect="AspectFit" />

      <VerticalStackLayout Grid.Row="1" VerticalOptions="End" Spacing="10">
        <Label Text="Find the right care for every pet"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalTextAlignment="Center"
               LineBreakMode="NoWrap"
               Margin="0,10,0,0" />
        <Label Text="Shop, connect, and access trusted veterinary care in one place."
               FontSize="12"
               TextColor="#EFE7FF"
               HorizontalTextAlignment="Center"
               LineBreakMode="NoWrap"
               Margin="0,0,0,8" />

        <Border Stroke="#5F687A"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18,18,18,18"
                BackgroundColor="#99121624"
                Padding="16"
                Margin="0,0,0,4">
          <VerticalStackLayout Spacing="10">
            <Label Text="Email" FontSize="13" TextColor="#F2EEFF" />
            <Border Stroke="#6F7789"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10,10,10,10"
                    BackgroundColor="#6618212F"
                    Padding="10,4">
              <Entry Text="{Binding Email}"
                     Placeholder="you@example.com"
                     TextColor="#F3F6FF"
                     PlaceholderColor="#AEB7CC"
                     Keyboard="Email"
                     ClearButtonVisibility="WhileEditing" />
            </Border>

            <Label Text="Password" FontSize="13" TextColor="#F2EEFF" />
            <Border Stroke="#6F7789"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10,10,10,10"
                    BackgroundColor="#6618212F"
                    Padding="10,4">
              <Entry Text="{Binding Password}"
                     Placeholder="Enter password"
                     TextColor="#F3F6FF"
                     PlaceholderColor="#AEB7CC"
                     IsPassword="True" />
            </Border>

            <Label Text="Forgot your password?"
                   FontSize="12"
                   TextColor="#B6C3DB"
                   FontFamily="OpenSansSemibold"
                   HorizontalOptions="End" />

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringBoolConverter}}"
                   TextColor="#C62828"
                   FontAttributes="Bold"
                   FontSize="13" />

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Primary}" />

            <Button Text="Login"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="0,4,0,0" />

            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
              <Label Text="Don't have an account?"
                     FontSize="13"
                     TextColor="#C2CADB"
                     VerticalOptions="Center" />
              <Button Text="Sign up"
                      Command="{Binding GoToRegisterCommand}"
                      Clicked="OnGoToRegisterClicked"
                      BackgroundColor="Transparent"
                      TextColor="#B6C3DB"
                      FontFamily="OpenSansSemibold"
                      Padding="0"
                      FontSize="13"
                      VerticalOptions="Center" />
            </HorizontalStackLayout>
          </VerticalStackLayout>
        </Border>
      </VerticalStackLayout>
    </Grid>
  </Grid>
</ContentPage>
