<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="floofy.Views.Register"
             Title="Register">
  <ScrollView>
    <VerticalStackLayout Padding="24"
                         Spacing="16">
      <Label Text="Create Account"
             FontSize="28"
             FontAttributes="Bold"
             HorizontalOptions="Center"/>

      <Label Text="Join Floofy today"
             FontSize="16"
             HorizontalOptions="Center"
             TextColor="Gray"/>
      <Entry x:Name="FullNameEntry"
             Placeholder="Full name"/>
      <Entry x:Name="EmailEntry"
             Placeholder="Email"
             Keyboard="Email"/>
      <Entry x:Name="PasswordEntry"
             Placeholder="Password"
             IsPassword="True"/>
      <Label Text="Select your role(s)"
             FontAttributes="Bold"
             Margin="0,8,0,0"/>
      <HorizontalStackLayout Spacing="12"
                             Margin="0,8,0,0">
        <CheckBox x:Name="BuyerCheckBox"/>
        <Label Text="Buyer"
               VerticalOptions="Center"/>
      </HorizontalStackLayout>
      <HorizontalStackLayout Spacing="12">
        <CheckBox x:Name="SellerCheckBox"/>
        <Label Text="Seller"
               VerticalOptions="Center"/>
      </HorizontalStackLayout>
      <Button Text="Create Account"
              Clicked="OnRegisterClicked"
              Margin="0,16,0,0"/>
      <Button Text="Already have an account? Login"
              Clicked="OnBackToLoginClicked"
              BackgroundColor="Transparent"
              TextColor="{StaticResource Primary}"/>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
