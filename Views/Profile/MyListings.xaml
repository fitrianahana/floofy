<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="floofy.Views.MyListings"
             Title="My Listings"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

  <Grid BackgroundColor="#F8F7FC"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="0">

    <!-- Header with improved visual design -->
    <Grid Grid.Row="0"
          ColumnDefinitions="Auto,*"
          Padding="12,20,16,16"
          ColumnSpacing="6"
          BackgroundColor="White">
      
      <Button Grid.Column="0"
              Text="←"
              Clicked="OnBackClicked"
              BackgroundColor="Transparent"
              TextColor="#2D1B4E"
              FontSize="20"
              FontAttributes="Bold"
              BorderWidth="0"
              CornerRadius="20"
              WidthRequest="40"
              HeightRequest="40"
              Padding="8,4,8,10"/>

      <VerticalStackLayout Grid.Column="1"
                           Spacing="4"
                           VerticalOptions="Center">
        <Label Text="My Listings"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="#2D1B4E"/>
        <Label Text="Pets you've listed for rehoming"
               FontSize="12"
               TextColor="#9B8FB1"/>
      </VerticalStackLayout>
    </Grid>

    <!-- Body -->
    <Grid Grid.Row="1">

      <ActivityIndicator IsRunning="{Binding IsLoading}"
                         IsVisible="{Binding IsLoading}"
                         Color="#B19CD9"
                         VerticalOptions="Center"
                         HorizontalOptions="Center"/>

      <CollectionView ItemsSource="{Binding Listings}"
                      IsVisible="{Binding ShowList}"
                      Margin="16,20,16,0"
                      SelectionMode="Single">
        <CollectionView.ItemsLayout>
          <LinearItemsLayout Orientation="Vertical"
                             ItemSpacing="12"/>
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <!-- Enhanced Card with visual improvements -->
            <Border StrokeShape="RoundRectangle 16,16,16,16"
                    Stroke="#E5DCFB"
                    StrokeThickness="1.5"
                    BackgroundColor="White"
                    Padding="0">

              <!-- Main card content -->
              <Grid RowDefinitions="*"
                    ColumnDefinitions="130,*,Auto"
                    ColumnSpacing="0"
                    RowSpacing="0">
                
                <Grid.GestureRecognizers>
                  <TapGestureRecognizer Tapped="OnListingTapped"/>
                </Grid.GestureRecognizers>

                <!-- Image with overlay -->
                <Grid Grid.Column="0"
                      RowSpacing="0">
                  <Image Source="{Binding Thumbnail, Converter={StaticResource ImageOrPlaceholderConverter}}"
                         Aspect="AspectFill"
                         HeightRequest="150"
                         WidthRequest="130"/>
                  
                  <!-- Active status badge -->
                  <Border BackgroundColor="#4CD18A"
                          StrokeShape="RoundRectangle 6,6,6,6"
                          Padding="6,3"
                          Margin="8,8,0,0"
                          VerticalOptions="Start"
                          HorizontalOptions="Start">
                    <Label Text="Active"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="White"
                           Margin="0"/>
                  </Border>
                </Grid>

                <!-- Content section with improved spacing -->
                <VerticalStackLayout Grid.Column="1"
                                     Padding="14,12,10,12"
                                     Spacing="6"
                                     VerticalOptions="Center">
                  
                  <!-- Pet name with better styling -->
                  <Label Text="{Binding Name}"
                         FontSize="15"
                         FontAttributes="Bold"
                         TextColor="#2D1B4E"
                         LineBreakMode="TailTruncation"
                         MaxLines="1"/>
                  
                  <!-- Species and breed with improved styling -->
                  <HorizontalStackLayout Spacing="6">
                    <Label Text="{Binding Species}"
                           FontSize="12"
                           TextColor="#8B7B9B"/>
                    <Label Text="•"
                           FontSize="10"
                           TextColor="#D4C5E2"
                           VerticalOptions="Center"/>
                    <Label Text="{Binding Breed}"
                           FontSize="12"
                           TextColor="#8B7B9B"
                           LineBreakMode="TailTruncation"/>
                  </HorizontalStackLayout>
                  
                  <!-- Age with icon-like styling -->
                  <HorizontalStackLayout Spacing="4"
                                        Margin="0,2,0,0">
                    <Label Text="🐾"
                           FontSize="11"
                           VerticalOptions="Center"/>
                    <Label Text="{Binding Age, StringFormat='{0} year(s) old'}"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#B19CD9"
                           VerticalOptions="Center"/>
                  </HorizontalStackLayout>

                  <!-- Cancel action - enhanced with visual feedback -->
                  <Label Text="✕  Cancel Rehoming"
                         FontSize="11"
                         FontAttributes="Bold"
                         TextColor="#FF6B6B"
                         Margin="0,6,0,0"
                         Opacity="0.8">
                     <Label.GestureRecognizers>
                       <TapGestureRecognizer Tapped="OnCancelListingClicked"/>
                     </Label.GestureRecognizers>
                  </Label>
                </VerticalStackLayout>

                <!-- Chevron indicator -->
                <Label Grid.Column="2"
                       Text="›"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#C9BDD4"
                       VerticalOptions="Center"
                       Margin="0,0,12,0"/>
              </Grid>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.Footer>
          <Grid HeightRequest="20"/>
        </CollectionView.Footer>
      </CollectionView>

      <!-- Enhanced empty state -->
      <VerticalStackLayout IsVisible="{Binding ShowEmpty}"
                           Padding="20,40,20,60"
                           Spacing="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
        
        <!-- Decorative circle background -->
        <Border BackgroundColor="#F0E5FF"
                StrokeShape="RoundRectangle 80,80,80,80"
                Padding="0"
                WidthRequest="120"
                HeightRequest="120"
                HorizontalOptions="Center">
          <Label Text="🏠"
                 FontSize="64"
                 HorizontalOptions="Center"
                 VerticalOptions="Center"/>
        </Border>
        
        <Label Text="No listings yet"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="#2D1B4E"
               HorizontalOptions="Center"/>
        
        <Label Text="Help pets find their forever home by listing them here"
               FontSize="13"
               TextColor="#8B7B9B"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               LineBreakMode="WordWrap"/>
        
        <Label Text="Start by clicking the button below"
               FontSize="12"
               TextColor="#B19CD9"
               HorizontalOptions="Center"
               FontAttributes="Italic"/>
      </VerticalStackLayout>
    </Grid>

    <!-- Enhanced Sticky CTA with better design -->
    <Border Grid.Row="2"
            BackgroundColor="White"
            Stroke="#E5DCFB"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 0,0,0,0"
            Padding="16,14,16,20">
      
      <Border.Shadow>
        <Shadow Brush="#08000000"
                Offset="0,-2"
                Radius="8"/>
      </Border.Shadow>

      <Button Text="✏️  Rehome a new pet"
              Clicked="OnRehomeClicked"
              BackgroundColor="#B19CD9"
              TextColor="White"
              CornerRadius="14"
              FontSize="14"
              FontAttributes="Bold"
              HeightRequest="48"
              Padding="20,0"
              CharacterSpacing="0.2"/>
    </Border>

    <!-- Enhanced Toast notification with better styling -->
    <Border Grid.Row="1"
            x:Name="Toast"
            VerticalOptions="End"
            HorizontalOptions="Center"
            StrokeShape="RoundRectangle 24,24,24,24"
            BackgroundColor="#2D1B4E"
            Stroke="Transparent"
            Padding="18,12"
            Margin="20,0,20,20"
            IsVisible="False"
            Opacity="0"
            InputTransparent="True">
      <Border.Shadow>
        <Shadow Brush="#40000000"
                Offset="0,6"
                Radius="16"/>
      </Border.Shadow>
      <HorizontalStackLayout Spacing="12">
        <Label Text="✓"
               FontSize="16"
               FontAttributes="Bold"
               TextColor="#4CD18A"
               VerticalOptions="Center"
               Margin="2,0,0,0"/>
        <Label x:Name="ToastMessage"
               Text=""
               FontSize="13"
               FontAttributes="Bold"
               TextColor="White"
               VerticalOptions="Center"
               LineBreakMode="TailTruncation"/>
      </HorizontalStackLayout>
    </Border>
  </Grid>
</ContentPage>
