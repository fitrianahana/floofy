<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:floofy.Controls"
             x:Class="floofy.Views.Home"
             Title="Home"
             NavigationPage.HasNavigationBar="False">
  <Grid BackgroundColor="#F8F7FC">
    <ScrollView Padding="0,0,0,96">
      <VerticalStackLayout Spacing="0" Padding="0">
        <!-- Header with greeting -->
        <VerticalStackLayout Padding="24,20,24,0" Spacing="8" BackgroundColor="#F8F7FC">
          <Label Text="Welcome back!"
                 FontSize="28"
                 FontAttributes="Bold"
                 TextColor="#2D1B4E" />
          <Label Text="Discover pets, products, and services"
                 FontSize="13"
                 TextColor="#6B5B8C"
                 LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <!-- Search Bar -->
        <VerticalStackLayout Padding="24,16,24,0">
          <SearchBar Placeholder="Search for pets or services..."
                     PlaceholderColor="#A89BBB"
                     TextColor="#2D1B4E"
                     BackgroundColor="White" 
                     CancelButtonColor="#6B5B8C" />
        </VerticalStackLayout>

        <!-- Quick Categories -->
        <VerticalStackLayout Padding="24,16,24,0" Spacing="8">
          <Label Text="Quick Categories"
                 FontSize="14"
                 FontAttributes="Bold"
                 TextColor="#2D1B4E" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10">
            <!-- Find Pets Card -->
            <Border Grid.Row="0" Grid.Column="0"
                    Stroke="#DDD2FF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14,14,14,14"
                    BackgroundColor="White"
                    Padding="16">
              <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="🐾"
                       FontSize="28"
                       HorizontalOptions="Center" />
                <Label Text="Find Pets"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#2D1B4E"
                       HorizontalTextAlignment="Center" />
              </VerticalStackLayout>
            </Border>

            <!-- Veterinary Card -->
            <Border Grid.Row="0" Grid.Column="1"
                    Stroke="#DDD2FF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14,14,14,14"
                    BackgroundColor="White"
                    Padding="16">
              <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="🏥"
                       FontSize="28"
                       HorizontalOptions="Center" />
                <Label Text="Veterinary"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#2D1B4E"
                       HorizontalTextAlignment="Center" />
              </VerticalStackLayout>
            </Border>

            <!-- Products Card -->
            <Border Grid.Row="1" Grid.Column="0"
                    Stroke="#DDD2FF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14,14,14,14"
                    BackgroundColor="White"
                    Padding="16">
              <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="🛍️"
                       FontSize="28"
                       HorizontalOptions="Center" />
                <Label Text="Products"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#2D1B4E"
                       HorizontalTextAlignment="Center" />
              </VerticalStackLayout>
            </Border>

            <!-- Community Card -->
            <Border Grid.Row="1" Grid.Column="1"
                    Stroke="#DDD2FF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14,14,14,14"
                    BackgroundColor="White"
                    Padding="16">
              <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="👥"
                       FontSize="28"
                       HorizontalOptions="Center" />
                <Label Text="Community"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#2D1B4E"
                       HorizontalTextAlignment="Center" />
              </VerticalStackLayout>
            </Border>
          </Grid>
        </VerticalStackLayout>

        <!-- Featured Section -->
        <VerticalStackLayout Padding="24,20,24,0" Spacing="8">
          <Label Text="Featured This Week"
                 FontSize="14"
                 FontAttributes="Bold"
                 TextColor="#2D1B4E" />
          
          <!-- Featured Item 1 -->
          <Border Stroke="#DDD2FF"
                  StrokeThickness="1"
                  StrokeShape="RoundRectangle 14,14,14,14"
                  BackgroundColor="White"
                  Padding="0">
            <Grid ColumnDefinitions="80,*" ColumnSpacing="12" Padding="12">
              <BoxView Grid.Column="0" 
                       Color="#E4DDF9"
                       CornerRadius="10"
                       WidthRequest="80"
                       HeightRequest="80" />
              <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <Label Text="Golden Retriever"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#2D1B4E" />
                <Label Text="Adult, Friendly &amp; Playful"
                       FontSize="11"
                       TextColor="#6B5B8C" />
                <Label Text="⭐ 4.8 rating"
                       FontSize="10"
                       TextColor="#B19CD9" />
              </VerticalStackLayout>
            </Grid>
          </Border>

          <!-- Featured Item 2 -->
          <Border Stroke="#DDD2FF"
                  StrokeThickness="1"
                  StrokeShape="RoundRectangle 14,14,14,14"
                  BackgroundColor="White"
                  Padding="0">
            <Grid ColumnDefinitions="80,*" ColumnSpacing="12" Padding="12">
              <BoxView Grid.Column="0" 
                       Color="#E4DDF9"
                       CornerRadius="10"
                       WidthRequest="80"
                       HeightRequest="80" />
              <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <Label Text="Pet Grooming Service"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#2D1B4E" />
                <Label Text="Professional grooming for all breeds"
                       FontSize="11"
                       TextColor="#6B5B8C" />
                <Label Text="⭐ 4.9 rating"
                       FontSize="10"
                       TextColor="#B19CD9" />
              </VerticalStackLayout>
            </Grid>
          </Border>
        </VerticalStackLayout>

        <!-- Promotions Banner -->
        <VerticalStackLayout Padding="24,20,24,24">
          <Border Stroke="#B19CD9"
                  StrokeThickness="1"
                  StrokeShape="RoundRectangle 14,14,14,14"
                  BackgroundColor="#F0E7FF"
                  Padding="16">
            <VerticalStackLayout Spacing="4">
              <Label Text="🎉 Special Offer"
                     FontSize="12"
                     FontAttributes="Bold"
                     TextColor="#B19CD9" />
              <Label Text="Get 20% off on all veterinary services this week!"
                     FontSize="13"
                     FontAttributes="Bold"
                     TextColor="#2D1B4E"
                     LineBreakMode="WordWrap" />
              <Button Text="View Details"
                      BackgroundColor="Transparent"
                      TextColor="#B19CD9"
                      FontSize="11"
                      BorderWidth="0"
                      Padding="0,8,0,0" />
            </VerticalStackLayout>
          </Border>
        </VerticalStackLayout>
      </VerticalStackLayout>
    </ScrollView>

    <controls:BottomNav ActiveTab="home"
                        VerticalOptions="End"/>
  </Grid>
</ContentPage>