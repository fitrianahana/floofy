<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:floofy"
             xmlns:converters="clr-namespace:floofy.Converters"
             x:Class="floofy.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Styles/Colors.xaml"/>
        <ResourceDictionary Source="Resources/Styles/Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- Value Converters -->
      <converters:StringBoolConverter x:Key="StringBoolConverter"/>
      <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
      <converters:RatingToStarsConverter x:Key="RatingToStarsConverter"/>
      <converters:StockToLabelConverter x:Key="StockToLabelConverter"/>
      <converters:StockToColorConverter x:Key="StockToColorConverter"/>
      <converters:ImageOrPlaceholderConverter x:Key="ImageOrPlaceholderConverter"/>
      <converters:CurrentUserPetConverter x:Key="CurrentUserPetConverter"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>